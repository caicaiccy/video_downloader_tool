{
  "manifest_version": 3,
  "name": "视频本地下载器",
  "version": "1.5.2",
  "description": "将有权保存的 Bilibili 或网页公开视频资源加入本地下载队列。",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "视频本地下载器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  }
}
